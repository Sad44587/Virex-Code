{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Virex",
  "scopeName": "source.virex",
  "fileTypes": [
    "vx",
    "vxm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.virex",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.virex"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.virex",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.virex"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.virex"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.virex",
              "match": "\\\\([\\\\\"ntr]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.virex",
          "match": "\\b([0-9]+\\.?[0-9]*(e[+-]?[0-9]+)?|\\.[0-9]+(e[+-]?[0-9]+)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.virex",
          "match": "\\b(if|else|while|for|return)\\b"
        },
        {
          "name": "keyword.declaration.virex",
          "match": "\\b(let|fn|pub|public|import|as)\\b"
        },
        {
          "name": "constant.language.virex",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.control.virex",
          "match": "\\b(print)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.math.virex",
          "match": "\\b(sin|cos|tan|sqrt|abs|pow|log|exp|floor|ceil|round|min|max|clamp)\\b"
        },
        {
          "name": "support.function.builtin.list.virex",
          "match": "\\b(list|push|pop|append|get|set|contains|len)\\b"
        },
        {
          "name": "support.function.builtin.string.virex",
          "match": "\\b(upper|lower|trim|split|join|substr|concat|str)\\b"
        },
        {
          "name": "support.function.builtin.file.virex",
          "match": "\\b(readFile|writeFile|exists)\\b"
        },
        {
          "name": "support.function.builtin.misc.virex",
          "match": "\\b(rand)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.virex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.virex"
            }
          }
        },
        {
          "name": "meta.function-definition.virex",
          "match": "\\b(fn|public\\s+fn|pub\\s+fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.virex"
            },
            "2": {
              "name": "entity.name.function.virex"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.virex",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.virex",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.virex",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arithmetic.virex",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.bracket.curly.virex",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.virex",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.virex",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.virex",
          "match": "[;,.]"
        }
      ]
    }
  }
}
